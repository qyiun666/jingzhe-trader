[Unit]
Description=Jingzhe Trader Watchdog (jingzhew)
After=network-online.target jingzhed.service
Requires=jingzhed.service

[Service]
Type=simple
ExecStart=/opt/jingzhe/jingzhew -addr http://127.0.0.1:8080 -interval 60s
Environment=JZ_WATCHDOG_TOKEN=CHANGE_ME
Environment=JZ_WATCHDOG_SMTP_HOST=smtp.qq.com
Environment=JZ_WATCHDOG_SMTP_PORT=465
Environment=JZ_WATCHDOG_SMTP_USER=CHANGE_ME
Environment=JZ_WATCHDOG_SMTP_PASS=CHANGE_ME
Environment=JZ_WATCHDOG_MAIL_TO=CHANGE_ME
Restart=always
RestartSec=10
User=jingzhe

[Install]
WantedBy=multi-user.target
