# 惊蛰（Jingzhe Trader）环境变量样例
#
# 配置优先级：环境变量 JZ_* > config 表同名键（详见 internal/config/keys.go）。
# 本文件不自动加载，需由 systemd/launchd（或 .env 注入器）注入进程环境。
# 复制为 .env 后填入真实值，切勿提交真实密钥。

# ---- 数据 / Tushare ----
JZ_TUSHARE_TOKEN=your_tushare_token_here

# ---- LLM（DeepSeek，买入候选终审）----
JZ_LLM_API_KEY=your_deepseek_key
JZ_LLM_BASE_URL=https://api.deepseek.com/v1
JZ_LLM_MODEL=deepseek-chat

# ---- MCP 服务鉴权（必填；为空 jingzhed 拒绝启动）----
# 生成：openssl rand -hex 32
JZ_SERVER_API_TOKEN=generate_a_strong_random_token_here

# ---- 邮件（可选；未启用则通知走落库告警）----
JZ_MAIL_FROM=your_mail@qq.com
JZ_MAIL_PASSWORD=your_mail_auth_code
JZ_MAIL_SMTP_HOST=smtp.qq.com
JZ_MAIL_SMTP_PORT=465
JZ_MAIL_ENABLED=true
JZ_WATCH_MAIL_TO=alert_recipient@example.com

# ---- 看门狗告警投递（jingzhew，可选）----
JZ_WATCHDOG_ADDR=http://127.0.0.1:8080
JZ_WATCHDOG_INTERVAL=60s
JZ_WATCHDOG_TOKEN=same_as_JZ_SERVER_API_TOKEN
JZ_WATCHDOG_SMTP_HOST=smtp.qq.com
JZ_WATCHDOG_SMTP_PORT=465
JZ_WATCHDOG_SMTP_USER=your_mail@qq.com
JZ_WATCHDOG_SMTP_PASS=your_mail_auth_code
JZ_WATCHDOG_MAIL_TO=alert_recipient@example.com
JZ_WATCHDOG_FAIL_THRESHOLD=3
