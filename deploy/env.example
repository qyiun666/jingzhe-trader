# 惊蛰（Jingzhe Trader）环境变量样例
#
# 配置优先级：环境变量 JZ_* > config 表同名键 > KeySpec 默认值
# （键目录见 internal/config/keys.go；write-once 键落库后环境变量不再顶换）。
# 本文件不自动加载，由启动方注入进程环境：
#   set -a; . ./.env; set +a
# 复制为 .env 后填入真实值，切勿提交真实密钥。

# ---- 数据 / Tushare（必填）----
JZ_TUSHARE_TOKEN=your_tushare_token_here

# ---- MCP 服务鉴权（必填；为空 serve 拒绝启动）----
# 生成：openssl rand -hex 32
JZ_SERVER_API_TOKEN=generate_a_strong_random_token_here

# ---- LLM（DeepSeek）：买什么、买多少由它定，风控只做硬截断 ----
# 关掉它当日不会有任何买单，并落一条 LLM_DISABLED urgent 告警（不是 LLM_FAILED ——
# 那个码表示部分候选评审未问出结果，是"问了没答出来"，与"没启用"是两件事）。
# 规则信号不替代决策：没有决策者时当日零买单，不会偷偷退回均线门槛。
JZ_LLM_API_KEY=your_deepseek_key
JZ_LLM_BASE_URL=https://api.deepseek.com/v1
JZ_LLM_MODEL=deepseek-v4-flash

# ---- 邮件通知（必需）：M1/M2/M3/M5 与 urgent 告警都靠它投递 ----
# 配置不完整（收件人缺失 / 凭据缺失 / mail.enabled=false）时 serve 与 run task 装配期直接失败。
# 投递去重：M1/M2/M5 当日各一封，urgent 告警同一 code 当日一封；手工补跑任务不会重复发信。
JZ_MAIL_FROM=your_mail@qq.com
JZ_MAIL_PASSWORD=your_mail_auth_code
JZ_MAIL_SMTP_HOST=smtp.qq.com
JZ_MAIL_SMTP_PORT=465
JZ_MAIL_ENABLED=true
# 收件人（逗号分隔）：M1~M6 与 urgent 告警共用；QQ 允许自发自收，填发件箱本身即可
JZ_WATCH_MAIL_TO=alert_recipient@example.com
