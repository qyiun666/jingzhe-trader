# 惊蛰服务凭据模板: 复制为 ~/.jingzhe.env 并填入真实值, chmod 600
# 该文件已被 .gitignore 排除, 禁止提交; 值只存在于本机 (launchd 经 scripts/start-server.sh 注入)
TUSHARE_TOKEN=          # 必需, Tushare 行情数据源
LLM_API_KEY=            # 可选, DeepSeek API 密钥 (启用多智能体辩论)
JZ_API_TOKEN=           # 推荐, HTTP API 鉴权
JZ_MAIL_PASSWORD=       # 可选, SMTP 授权码 (盘前总结/日报推送)
