<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 惊蛰交易系统常驻守护: 开机自启 + 崩溃自动拉起 (ThrottleInterval 限频防刷) -->
<!-- 安装: cp scripts/com.jingzhe.trader.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jingzhe.trader.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jingzhe.trader</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Volumes/zt_hd/projects/jingzhe-trader/scripts/start-server.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Volumes/zt_hd/projects/jingzhe-trader</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/Volumes/zt_hd/projects/jingzhe-trader/logs/launchd-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/zt_hd/projects/jingzhe-trader/logs/launchd-stderr.log</string>
</dict>
</plist>
