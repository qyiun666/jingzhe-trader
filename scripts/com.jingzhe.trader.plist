<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS launchd 部署示例: 复制到 ~/Library/LaunchAgents/ 后
     launchctl load ~/Library/LaunchAgents/com.jingzhe.trader.plist
     路径按实际部署位置修改 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jingzhe.trader</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/jingzhe-trader/bin/server</string>
        <string>-config</string>
        <string>/opt/jingzhe-trader/config/config.yaml</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/opt/jingzhe-trader</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/opt/jingzhe-trader/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/opt/jingzhe-trader/logs/launchd.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- 敏感配置走环境变量, 勿写入 config.yaml -->
        <!-- <key>TUSHARE_TOKEN</key><string>xxx</string> -->
        <!-- <key>JZ_API_TOKEN</key><string>xxx</string> -->
        <!-- <key>FEISHU_WEBHOOK</key><string>https://open.feishu.cn/open-apis/bot/v2/hook/xxx</string> -->
    </dict>
</dict>
</plist>
